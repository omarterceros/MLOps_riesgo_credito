<mxfile host="riesgo-credito-mlops"><diagram id="02-ciclo-de-vida-modelo" name="02-ciclo-de-vida-modelo"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Ciclo de vida de una version del modelo: champion, challenger, compuerta y rollback" style="text;html=1;align=center;fontSize=16;fontStyle=1;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1180" height="30" as="geometry"/></mxCell><mxCell id="exp" value="&lt;b&gt;Experimento riesgo-credito&lt;/b&gt;&lt;br&gt;8 runs comparables&lt;br&gt;(misma particion, semilla 42)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="230" height="70" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;Compuerta de calidad&lt;/b&gt;&lt;br&gt;roc_auc &gt;= 0.75&lt;br&gt;y &gt; champion actual" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="200" height="70" as="geometry"/></mxCell><mxCell id="reg" value="&lt;b&gt;Model Registry riesgo-credito&lt;/b&gt;&lt;br&gt;v1 = logreg_C1 (0.710) alias baseline&lt;br&gt;v2 = hgb (0.780) alias champion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="70" width="300" height="90" as="geometry"/></mxCell><mxCell id="pods" value="&lt;b&gt;Pods en Kubernetes&lt;/b&gt;&lt;br&gt;cargan models:/riesgo-credito@champion&lt;br&gt;al arrancar (readiness)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="80" width="220" height="80" as="geometry"/></mxCell><mxCell id="mon" value="&lt;b&gt;Monitoreo mensual&lt;/b&gt;&lt;br&gt;validar_datos -&gt; data drift -&gt;&lt;br&gt;concept drift cuando llegan etiquetas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="240" width="220" height="80" as="geometry"/></mxCell><mxCell id="alarma" value="&lt;b&gt;Alarma&lt;/b&gt;&lt;br&gt;roc_auc cae &gt; 0.05 por 3 lotes&lt;br&gt;(o &gt; 0.12 en uno)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="380" width="220" height="70" as="geometry"/></mxCell><mxCell id="challenger" value="&lt;b&gt;Reentrenar challenger&lt;/b&gt;&lt;br&gt;con lotes recientes etiquetados&lt;br&gt;-&gt; version 3 en el registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="380" width="300" height="70" as="geometry"/></mxCell><mxCell id="promo" value="&lt;b&gt;Mover alias champion -&gt; v3&lt;/b&gt;&lt;br&gt;kubectl rollout restart&lt;br&gt;(maxSurge 1 / maxUnavailable 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="380" width="200" height="80" as="geometry"/></mxCell><mxCell id="rollback" value="&lt;b&gt;Rollback: alias -&gt; version anterior&lt;/b&gt;&lt;br&gt;+ rollout restart&lt;br&gt;(sin reconstruir la imagen)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="230" height="80" as="geometry"/></mxCell><mxCell id="rechazo" value="&lt;b&gt;RECHAZADO:&lt;/b&gt;&lt;br&gt;el alias no se mueve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="220" width="200" height="60" as="geometry"/></mxCell><mxCell id="e0" value="candidato" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" source="exp" target="gate" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="APROBADO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" source="gate" target="reg" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="no pasa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=10;" edge="1" source="gate" target="rechazo" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="por alias" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" source="reg" target="pods" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="predicciones" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" source="pods" target="mon" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="degradacion sostenida" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" source="mon" target="alarma" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="CT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" source="alarma" target="challenger" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="pasa por la misma compuerta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=10;" edge="1" source="challenger" target="gate" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="si gana" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" source="gate" target="promo" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="si sale mal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=10;" edge="1" source="promo" target="rollback" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=10;" edge="1" source="rollback" target="reg" parent="1"><mxGeometry relative="1