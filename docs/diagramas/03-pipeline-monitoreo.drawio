<mxfile host="riesgo-credito-mlops"><diagram id="03-pipeline-monitoreo" name="03-pipeline-monitoreo"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Que le pasa a un lote nuevo: validacion de datos, data drift y concept drift" style="text;html=1;align=center;fontSize=16;fontStyle=1;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1180" height="30" as="geometry"/></mxCell><mxCell id="c_sin" value="Sin etiqueta: se calcula el mismo dia" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=45;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1140" height="250" as="geometry"/></mxCell><mxCell id="c_con" value="Con etiqueta: llega 30-90 dias despues (ground truth delay)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;opacity=45;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="1140" height="240" as="geometry"/></mxCell><mxCell id="lote" value="&lt;b&gt;Lote mensual&lt;/b&gt;&lt;br&gt;(500-1.500 clientes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="180" height="60" as="geometry"/></mxCell><mxCell id="val" value="&lt;b&gt;validar_datos.py&lt;/b&gt;&lt;br&gt;esquema, nulos, rangos,&lt;br&gt;minimo de filas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="110" width="200" height="80" as="geometry"/></mxCell><mxCell id="rechazo" value="&lt;b&gt;RECHAZADO (codigo 1)&lt;/b&gt;&lt;br&gt;se detiene el flujo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="220" width="200" height="60" as="geometry"/></mxCell><mxCell id="dd" value="&lt;b&gt;data_drift.py&lt;/b&gt;&lt;br&gt;numericas: KS + PSI&lt;br&gt;categoricas/ordinales: chi2 + PSI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="250" height="80" as="geometry"/></mxCell><mxCell id="sem" value="&lt;b&gt;VERDE / AMARILLO / ROJO&lt;/b&gt;&lt;br&gt;PSI 0.10 / 0.25 · alfa 0.01&lt;br&gt;efecto minimo 0.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="230" height="80" as="geometry"/></mxCell><mxCell id="psi" value="&lt;b&gt;Senales sin etiqueta:&lt;/b&gt;&lt;br&gt;PSI del score, tasa de positivos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="220" width="250" height="60" as="geometry"/></mxCell><mxCell id="rojo" value="&lt;b&gt;ROJO: investigar y vigilar&lt;/b&gt;&lt;br&gt;(no reentrena solo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="220" width="230" height="60" as="geometry"/></mxCell><mxCell id="etiq" value="&lt;b&gt;Etiquetas reales&lt;/b&gt;&lt;br&gt;(mora del mes siguiente)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="180" height="60" as="geometry"/></mxCell><mxCell id="cd" value="&lt;b&gt;concept_drift.py&lt;/b&gt;&lt;br&gt;roc_auc por lote vs referencia 0.780&lt;br&gt;umbral 0.730" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="390" width="250" height="80" as="geometry"/></mxCell><mxCell id="crit" value="&lt;b&gt;Criterio: caida &gt; 0.05&lt;/b&gt;&lt;br&gt;durante 3 lotes seguidos&lt;br&gt;o &gt; 0.12 en un lote" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="390" width="230" height="80" as="geometry"/></mxCell><mxCell id="alarma" value="&lt;b&gt;ALARMA (lote 9 en la simulacion)&lt;/b&gt;&lt;br&gt;-&gt; reentrenar challenger&lt;br&gt;-&gt; compuerta -&gt; alias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="390" width="280" height="80" as="geometry"/></mxCell><mxCell id="ok" value="&lt;b&gt;Sin alarma: el modelo sigue sirviendo&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="500" width="230" height="50" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" source="lote" target="val" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="problemas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=10;" edge="1" source="val" target="rechazo" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="OK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" source="val" target="dd" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" source="dd" target="sem" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=10;" edge="1" source="dd" target="psi" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=10;" edge="1" source="sem" target="rojo" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;