<mxfile host="riesgo-credito-mlops"><diagram id="04-kubernetes-peticion" name="04-kubernetes-peticion"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Dentro de Kubernetes: como llega una peticion y como se mantiene el servicio" style="text;html=1;align=center;fontSize=16;fontStyle=1;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1180" height="30" as="geometry"/></mxCell><mxCell id="c_ns" value="namespace riesgo-credito" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=45;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="60" width="920" height="430" as="geometry"/></mxCell><mxCell id="cli" value="&lt;b&gt;curl / navegador&lt;/b&gt;&lt;br&gt;localhost:30080/predecir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="230" width="180" height="60" as="geometry"/></mxCell><mxCell id="svc" value="&lt;b&gt;Service (NodePort 30080)&lt;/b&gt;&lt;br&gt;IP virtual + DNS&lt;br&gt;kube-proxy reparte cada conexion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="220" width="230" height="80" as="geometry"/></mxCell><mxCell id="eps" value="&lt;b&gt;EndpointSlice&lt;/b&gt;&lt;br&gt;IPs de los pods Ready&lt;br&gt;(entran y salen solos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="360" width="230" height="70" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;pod api-1&lt;/b&gt;&lt;br&gt;modelo v2 en memoria&lt;br&gt;READY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="100" width="170" height="70" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;pod api-2&lt;/b&gt;&lt;br&gt;modelo v2 en memoria&lt;br&gt;READY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="220" width="170" height="70" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;pod api-3&lt;/b&gt;&lt;br&gt;(nuevo, cargando modelo)&lt;br&gt;NO READY: sin trafico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="340" width="170" height="70" as="geometry"/></mxCell><mxCell id="rs" value="&lt;b&gt;ReplicaSet / Deployment&lt;/b&gt;&lt;br&gt;estado deseado: 3 pods&lt;br&gt;si uno muere, crea otro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="220" height="80" as="geometry"/></mxCell><mxCell id="probes" value="&lt;b&gt;readiness /health: Ready solo con&lt;/b&gt;&lt;br&gt;el modelo cargado&lt;br&gt;liveness /vivo: reinicia si no responde" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="230" width="330" height="80" as="geometry"/></mxCell><mxCell id="res" value="&lt;b&gt;requests 250m / 512Mi&lt;/b&gt;&lt;br&gt;limits 1 CPU / 1Gi&lt;br&gt;rolling update maxSurge 1 / maxUnavailable 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="360" width="330" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" source="cli" target="svc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" source="svc" target="p1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" source="svc" target="p2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="no (no Ready)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=10;" edge="1" source="svc" target="p3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=10;" edge="1" source="eps" target="svc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=10;" edge="1" source="rs" target="p1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=10;" edge="1" source="rs" target="p2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="crea" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=10;" edge="1" source="rs" target="p3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>